{
  "name": "commitlint-lite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "validate-commit": "dist/cli.js"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "npm run build && vitest run",
    "test:coverage": "npm run build && vitest run --coverage",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^20.16.0",
    "@vitest/coverage-v8": "^4.0.0",
    "eslint": "^9.13.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.10.0",
    "vitest": "^4.0.0"
  }
}
